.game-menu
    .game-menu__top
        .game-menu__top-left
            .game-menu__welcome
                img.game-menu__logo-background(src="/images/common/logo_background.png" alt="Logo de Tipeando")
                span.game-menu__welcome-title
                    .game-menu__welcome-title--1 Tipe
                    .game-menu__welcome-title--2 A
                    .game-menu__welcome-title--1 ndo
            .button.game-menu__sign-button.game-menu__sign-button--route-list(role="button" tabindex="0")
                | Lista de Rutas
            .button.game-menu__sign-button.game-menu__sign-button--how-to-play(role="button" tabindex="0")
                | Como Jugar
            .button.game-menu__sign-button.game-menu__sign-button--achievements(role="button" tabindex="0")
                | Trofeos
            .button.game-menu__sign-button.game-menu__sign-button--settings(role="button" tabindex="0")
                | Configuración
    //- Direct child of .game-menu (full screen), not of .game-menu__top, so the
    //- panel can run the full height of the left edge.
    aside.game-menu__info-card.hidden(aria-label="Información de la ruta")
        .game-menu__info-card-header
            .game-menu__route-sign
                .game-menu__route-sign-top
                    span.game-menu__route-number
                .game-menu__route-sign-bottom
                    span.game-menu__route-length
            span.game-menu__route-name
            .button.game-menu__info-card-close(role="button" aria-label="Cerrar")
                svg( xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x-icon lucide-x")
                    path( d="M18 6 6 18")
                    path( d="m6 6 12 12")

        .game-menu__info-card-body
            .game-menu__info-card-image.image
                img(src="#" alt="")
            .game-menu__route-description

            section.game-menu__info-card-section
                .game-menu__info-card-section-header
                    span.game-menu__info-card-section-title Records
                    .stars.stars--md.game-menu__route-stars
                .game-menu__route-record-values
                    .game-menu__route-record-group
                        span.game-menu__route-record-label Combo
                        span.game-menu__route-record-value.game-menu__route-record-combo --
                    .game-menu__route-record-group
                        span.game-menu__route-record-label PPM Total
                        span.game-menu__route-record-value.game-menu__route-record-gross-wpm --
                    .game-menu__route-record-group
                        span.game-menu__route-record-label PPM - Errores
                        span.game-menu__route-record-value.game-menu__route-record-net-wpm --
                    .game-menu__route-record-group
                        span.game-menu__route-record-label Precisión
                        span.game-menu__route-record-value.game-menu__route-record-accuracy --
                    .game-menu__route-record-group
                        span.game-menu__route-record-label Tiempo
                        span.game-menu__route-record-value.game-menu__route-record-time --:--
                    .game-menu__route-record-group
                        span.game-menu__route-record-label Errores
                        span.game-menu__route-record-value.game-menu__route-record-mistakes --

            section.game-menu__info-card-section
                .game-menu__info-card-section-header
                    span.game-menu__info-card-section-title Ciudades
                    span.game-menu__route-cities-count
                ol.game-menu__route-cities

        .game-menu__info-card-footer
            .button.game-menu__button(role="button" tabindex="0")
                | Empezar
    .game-menu__bottom
    //- Country-wide progress; hidden until the first route is completed.
    .game-menu__progress.hidden(role="region" aria-label="Progreso")
        .game-menu__progress-header
            span.game-menu__progress-label Argentina recorrida
            span.game-menu__progress-percent 0%
        .game-menu__progress-bar
            .game-menu__progress-bar-fill
        .game-menu__progress-stats
            .game-menu__progress-stat
                span.game-menu__progress-stat-label PPM promedio
                span.game-menu__progress-stat-value.game-menu__progress-wpm-best --
    .game-menu__keys-tip(aria-hidden="true")
        span.game-menu__keys-tip-note Usá las flechas del teclado para moverte por el menú
        svg.game-menu__keys-tip-arrow(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 80 70" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
            path.game-menu__keys-tip-arrow-line(d="M6 6 C 10 30, 30 50, 66 58")
            path.game-menu__keys-tip-arrow-line(d="M52 50 L 67 58 L 54 66")
        svg.game-menu__keys-tip-keys(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 124 84" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
            //- one group per key (keycap + glyph) so each can pop in on its own;
            //- keycaps are drawn a little crooked so they read as sketched
            g.game-menu__keys-tip-key
                path(d="M5 45 L 39 44 L 40 79 L 4 80 Z")
                path(d="M31 62 L 14 62 M 20 55 L 13 62 L 20 69")
            g.game-menu__keys-tip-key
                path(d="M45 44 L 79 45 L 78 80 L 44 79 Z")
                path(d="M62 53 L 61 70 M 55 64 L 61 71 L 68 64")
            g.game-menu__keys-tip-key
                path(d="M84 45 L 119 44 L 120 79 L 85 80 Z")
                path(d="M93 62 L 110 62 M 104 55 L 111 62 L 104 69")
            g.game-menu__keys-tip-key
                path(d="M45 5 L 79 4 L 80 37 L 44 38 Z")
                path(d="M62 29 L 62 13 M 55 19 L 62 12 L 68 19")
    //- Shown while the route card is open: what each key does from there.
    //- Same sketched keycaps as the home hint; each row pops in on its own.
    .game-menu__route-keys-tip(aria-hidden="true")
        .game-menu__route-keys-tip-row
            svg.game-menu__route-keys-tip-keys(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 80 40" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
                path(d="M4 3 L 36 2 L 37 36 L 3 37 Z")
                path(d="M20 29 L 20 11 M 13 17 L 20 10 L 27 17")
                path(d="M43 2 L 76 3 L 75 37 L 42 36 Z")
                path(d="M59 11 L 59 28 M 52 22 L 59 29 L 66 22")
            span.game-menu__route-keys-tip-label Cambiar ruta
        .game-menu__route-keys-tip-row
            svg.game-menu__route-keys-tip-keys(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 80 40" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
                path(d="M4 3 L 36 2 L 37 36 L 3 37 Z")
                path(d="M29 20 L 11 20 M 17 13 L 10 20 L 17 27")
            span.game-menu__route-keys-tip-label Volver al menú
        .game-menu__route-keys-tip-row
            svg.game-menu__route-keys-tip-keys(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 80 40" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
                path(d="M3 3 L 76 2 L 77 36 L 4 37 Z")
                path(d="M58 11 L 58 22 L 22 22 M 29 15 L 21 22 L 29 29")
            span.game-menu__route-keys-tip-label Empezar
