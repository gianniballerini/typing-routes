.game-playing.hidden
    input.game-playing__keyboard-focus-target(
        type='text'
        autocomplete='off'
        autocapitalize='off'
        autocorrect='off'
        spellcheck='false'
        aria-label='Entrada de teclado del juego'
    )
    .button.game-playing__quit(role='button' tabindex='0' aria-label='Salir de la ruta y volver al mapa')
        svg( xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left-icon lucide-arrow-left")
            path( d="m12 19-7-7 7-7")
            path( d="M19 12H5")
        span.game-playing__quit-text Salir
    .game-playing__top
        .game-playing__timer
            span.game-playing__timer-number
            span :
            span.game-playing__timer-milliseconds
    .game-playing__bottom
        .game-playing__user-stats
            .game-playing__user-stats-top
                .game-playing__stats-net-wpm
                    span.game-playing__net-wpm-number
                    span.game-playing__stats-unit ppm
                .game-playing__stats-secondary
                    .game-playing__stats-gross-wpm
                        span.game-playing__gross-wpm-number
                        span bruto
                    .game-playing__stats-cities
                        span.game-playing__cities-completed
                        span /
                        span.game-playing__cities-remaining
            .game-playing__user-stats-bottom
                .game-playing__stats-combo
                    span.game-playing__combo-number
                    span combo
                .game-playing__stats-accuracy
                    span.game-playing__accuracy-number
                    span precisión
        .game-playing__typing-card
            .game-playing__typing-card-top
                span.game-playing__typing-prev-city
                .game-playing__typing
                    span.game-playing__typing-ok
                    span.game-playing__typing-caret
                    span.game-playing__typing-next-char
                    span.game-playing__typing-rest
                span.game-playing__typing-next-city
            .game-playing__typing-card-bottom
                .game-playing__route-name

