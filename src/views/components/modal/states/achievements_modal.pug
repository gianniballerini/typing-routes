.achievements-modal.hidden
    .achievements-modal__content
        .achievements-modal__top
            .achievements-modal__title
                span.achievements-modal__title-text Trofeos
            .button.achievements-modal__close-button(role="button" tabindex="0" aria-label="Cerrar")
                svg( xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x-icon lucide-x")
                    path( d="M18 6 6 18")
                    path( d="m6 6 12 12")
        .achievements-modal__bottom
            .achievements-modal__progress
                span.achievements-modal__progress-text
            .achievements-modal__list(role="listbox" tabindex="0" aria-label="Trofeos")
            .achievements-modal__footer-hint
                span ↑ ↓ mover
                span ESC salir

        //- Cloned once per trophy by AchievementsModal.
        template.achievements-modal__row-template
            .achievements-modal__row(role="option")
                .achievements-modal__row-image
                    img(src="#" alt="" loading="lazy")
                .achievements-modal__row-body
                    span.achievements-modal__row-title
                    p.achievements-modal__row-description
